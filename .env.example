# Local defaults match compose.yaml. Replace every secret in deployed environments.
DATABASE_URL=postgresql://curriculo:curriculo@localhost:5432/curriculo
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=local-development-secret-change-before-deploying-32-chars
TRUSTED_ORIGINS=http://localhost:3000

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Curriculo <no-reply@curriculo.local>
SMTP_USER=
SMTP_PASSWORD=

DEFAULT_ORGANIZATION_SLUG=aibuilders-mexico
DEFAULT_PROGRAM_SLUG=odin-full-stack-mx
# Optional: after this verified account exists, db:seed grants developer-admin.
BOOTSTRAP_DEVELOPER_ADMIN_EMAIL=
SOCIAL_FEATURES_ENABLED=false
LOG_LEVEL=info
WORKER_POLL_INTERVAL_MS=2000
